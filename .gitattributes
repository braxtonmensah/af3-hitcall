# These are executed on Linux (Quartz login/compute nodes, rented pods). CRLF breaks the shebang
# with "bad interpreter: /bin/bash^M", so keep them LF in the working copy on Windows too.
*.sh        text eol=lf
*.slurm     text eol=lf

# job YAMLs are consumed on Linux; a CR inside the msa: path breaks the run
*.yaml text eol=lf
*.a3m  text eol=lf
